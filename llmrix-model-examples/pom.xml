<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.llmrix.model</groupId>
        <artifactId>llmrix-router</artifactId>
        <version>1.0.2</version>
    </parent>
    <artifactId>llmrix-model-examples</artifactId>
    <packaging>pom</packaging>
    <name>llmrix-model-examples</name>
    <description>Executable examples and module-scoped test projects for LLMRix Router</description>

    <properties>
        <!-- Skip deployment for all example modules and their children -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- Skip GPG signing for examples (not published) -->
        <gpg.skip>true</gpg.skip>
        <!-- Skip source/javadoc jars for examples -->
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <modules>
        <module>llmrix-model-router-core-examples</module>
        <module>llmrix-model-router-integrations-examples</module>
        <module>llmrix-model-router-spring-starter-examples</module>
        <module>llmrix-model-router-server-examples</module>
        <module>llmrix-model-client-examples</module>
    </modules>
</project>
