llmrix.model.router.default-route=general

llmrix.model.router.routes.general.strategy=balanced
llmrix.model.router.routes.general.models[0].integration=openrouter
llmrix.model.router.routes.general.models[0].model=openrouter/free
llmrix.model.router.routes.general.models[1].integration=openrouter
llmrix.model.router.routes.general.models[1].model=minimax/minimax-m3:free
llmrix.model.router.routes.general.models[2].integration=openrouter
llmrix.model.router.routes.general.models[2].model=google/gemma-4-31b-it:free
llmrix.model.router.routes.general.models[3].integration=openrouter
llmrix.model.router.routes.general.models[3].model=z-ai/glm-5.2:free

llmrix.model.router.routes.reasoning.strategy=balanced
llmrix.model.router.routes.reasoning.models[0].integration=openrouter
llmrix.model.router.routes.reasoning.models[0].model=nvidia/nemotron-3-super-120b-a12b:free
llmrix.model.router.routes.reasoning.models[1].integration=openrouter
llmrix.model.router.routes.reasoning.models[1].model=minimax/minimax-m2.7:free
llmrix.model.router.routes.reasoning.models[2].integration=openrouter
llmrix.model.router.routes.reasoning.models[2].model=z-ai/glm-5.2:free

llmrix.model.router.routes.code.strategy=balanced
llmrix.model.router.routes.code.models[0].integration=openrouter
llmrix.model.router.routes.code.models[0].model=cohere/north-mini-code:free
llmrix.model.router.routes.code.models[1].integration=openrouter
llmrix.model.router.routes.code.models[1].model=z-ai/glm-5.2:free
llmrix.model.router.routes.code.models[2].integration=openrouter
llmrix.model.router.routes.code.models[2].model=nvidia/nemotron-3-super-120b-a12b:free

llmrix.model.router.routes.vision.strategy=balanced
llmrix.model.router.routes.vision.models[0].integration=openrouter
llmrix.model.router.routes.vision.models[0].model=google/gemma-4-31b-it:free
llmrix.model.router.routes.vision.models[1].integration=openrouter
llmrix.model.router.routes.vision.models[1].model=google/gemma-4-26b-a4b-it:free
llmrix.model.router.routes.vision.models[2].integration=openrouter
    llmrix.model.router.routes.vision.models[2].model=minimax/minimax-m3:free
llmrix.model.router.routes.vision.models[3].integration=openrouter
llmrix.model.router.routes.vision.models[3].model=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

llmrix.model.router.routes.multimodal.strategy=balanced
llmrix.model.router.routes.multimodal.models[0].integration=openrouter
llmrix.model.router.routes.multimodal.models[0].model=thinkingmachines/inkling:free
llmrix.model.router.routes.multimodal.models[1].integration=openrouter
llmrix.model.router.routes.multimodal.models[1].model=thinkingmachines/inkling-small:free
llmrix.model.router.routes.multimodal.models[2].integration=openrouter
llmrix.model.router.routes.multimodal.models[2].model=google/gemma-4-31b-it:free
llmrix.model.router.routes.multimodal.models[3].integration=openrouter
llmrix.model.router.routes.multimodal.models[3].model=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

llmrix.model.router.routes.long-context.strategy=balanced
llmrix.model.router.routes.long-context.models[0].integration=openrouter
llmrix.model.router.routes.long-context.models[0].model=nvidia/nemotron-3-super-120b-a12b:free

llmrix.model.router.execution.timeout=60s
llmrix.model.router.execution.max-retries=1
llmrix.model.router.state.mode=local

llmrix.model.router.integrations.openrouter.provider=openrouter
llmrix.model.router.integrations.openrouter.base-url=${OPENROUTER_BASE_URL:https://openrouter.ai/api/v1}
llmrix.model.router.integrations.openrouter.api-key=${OPENROUTER_API_KEY}
llmrix.model.router.integrations.openrouter.models[0].name=openrouter/free
llmrix.model.router.integrations.openrouter.models[0].capabilities=chat,tools,vision
llmrix.model.router.integrations.openrouter.models[1].name=minimax/minimax-m3:free
llmrix.model.router.integrations.openrouter.models[1].capabilities=chat,tools,vision,video-input
llmrix.model.router.integrations.openrouter.models[2].name=google/gemma-4-31b-it:free
llmrix.model.router.integrations.openrouter.models[2].capabilities=chat,tools,vision,video-input
llmrix.model.router.integrations.openrouter.models[3].name=google/gemma-4-26b-a4b-it:free
llmrix.model.router.integrations.openrouter.models[3].capabilities=chat,tools,vision,video-input
llmrix.model.router.integrations.openrouter.models[4].name=z-ai/glm-5.2:free
llmrix.model.router.integrations.openrouter.models[4].capabilities=chat,tools,code,reasoning
llmrix.model.router.integrations.openrouter.models[5].name=nvidia/nemotron-3-super-120b-a12b:free
llmrix.model.router.integrations.openrouter.models[5].capabilities=chat,tools,reasoning,long-context
llmrix.model.router.integrations.openrouter.models[6].name=minimax/minimax-m2.7:free
llmrix.model.router.integrations.openrouter.models[6].capabilities=chat,tools,reasoning
llmrix.model.router.integrations.openrouter.models[7].name=cohere/north-mini-code:free
llmrix.model.router.integrations.openrouter.models[7].capabilities=chat,tools,code
llmrix.model.router.integrations.openrouter.models[8].name=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
llmrix.model.router.integrations.openrouter.models[8].capabilities=chat,tools,vision,reasoning,video-input,audio-input
llmrix.model.router.integrations.openrouter.models[9].name=thinkingmachines/inkling:free
llmrix.model.router.integrations.openrouter.models[9].capabilities=chat,vision
llmrix.model.router.integrations.openrouter.models[10].name=thinkingmachines/inkling-small:free
llmrix.model.router.integrations.openrouter.models[10].capabilities=chat,vision

llmrix.model.router.http.enabled=true
llmrix.model.router.http.auth.mode=api-key
llmrix.model.router.http.auth.bootstrap-key=${LLMRIX_MODEL_ROUTER_API_KEY}
